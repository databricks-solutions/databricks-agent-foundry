# Brick package data shipped inside the wheel (issue #81, 68-A).
# Brick scripts load these via importlib.resources; without them the
# wheel is not self-contained.
#
# Why the frontend extensions (.ts/.tsx/.js/.jsx/.css/.html):
# payloads/agent/ui/overrides/ ships TypeScript/React files that
# start_app.py:_apply_overrides() overlays onto the cloned
# e2e-chatbot-app-next template. Omitting them strips the entire
# extended-feedback UI from wheel-installed deploys (regression
# observed after the deploy-staging fix in #112 stopped relying on
# accidental "framework pollution" in the workspace).
recursive-include bricks *.py *.yml *.yaml *.json *.md *.sql *.txt *.ts *.tsx *.mjs *.js *.jsx *.css *.html
recursive-include payloads *.yml *.yaml *.json *.md *.sql *.txt *.ts *.tsx *.mjs *.js *.jsx *.css *.html
# Synthetic (macOS ``say``) speech clip for the speech-input smoke probe.
include payloads/agent/smoke_data/speech_probe.m4a
recursive-include payloads/agent/deploy/speech/_scaffold *.py

# JSON Schemas generated from the typed config models (#191, F-PR3).
# Loaded via ``agent_foundry.schemas.generate_all_schemas`` and copied
# into downstream repos by ``agent-foundry sync-schemas``.
recursive-include agent_foundry/schemas *.schema.json

# Lock-derived pip constraints installed into Databricks Apps via
# staging/requirements.txt ``-c`` lines. Regenerated by
# ``python -m agent_foundry.constraints.export`` after ``uv lock``.
recursive-include agent_foundry/constraints *.txt
recursive-include agent_foundry/testing *.toml
recursive-include agent_foundry/testing/fixtures *

# Named end-to-end variants for ``agent-foundry init`` (#210).
# Copied byte-for-byte into the generated repo's
# ``instances/<name>/`` directory at init time.  We include ``*.py``
# here because each variant ships pytest fixtures and integration
# tests that downstream users will actually run; the
# ``prune ... __pycache__`` directives below keep the bytecode out.
recursive-include examples *.yml *.yaml *.json *.md *.sql *.toml *.txt *.py
# README images (icon, architecture), so generated repos render them.
recursive-include examples/*/assets *.png *.svg
prune examples/__pycache__
prune examples/**/__pycache__

# Keep tests and bytecode out of the wheel. ``prune`` covers both the
# real per-brick paths and any accidental ``.pyc`` drops under them.
prune bricks/*/tests
prune bricks/*/__pycache__

# Docs stay in the sdist (for reference) but not in the wheel.
# setuptools handles that via the packages.find exclude list.
