    "PromptsConfig": {
      "description": "Server-side prompt consumption.\n\nDisabled by default (\"discover but do not consume\"). Setting\n``enabled: true`` with an empty ``allow`` is legal but warned about\nby ``payloads/agent/deploy/mcp/validate.py`` -- usually a config mistake.\n\n``cache: per_process`` is a forward-compat literal; PR 1 rejects it\nso callers fail fast rather than silently downgrading.",
      "properties": {
        "allow": {
          "items": {
            "type": "string"
          },
          "title": "Allow",
          "type": "array"
        },
        "cache": {
          "default": "per_conversation",
          "enum": [
            "per_request",
            "per_conversation",
            "per_process"
          ],
          "title": "Cache",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "inject_into": {
          "default": "dynamic_instructions",
          "enum": [
            "dynamic_instructions",
            "system_prompt",
            "none"
          ],
          "title": "Inject Into",
          "type": "string"
        }
      },
      "title": "PromptsConfig",
      "type": "object"
    },
    "ResourcesConfig": {
      "description": "Server-side resource consumption (URI-keyed read-only data).\n\nPR 1 only models the shape; the ``read_tool`` exposure path lands in\nPR 4 (#110). ``allow`` accepts exact URIs *or* glob patterns -- glob\nis the natural fit for content-addressable servers.",
      "properties": {
        "allow": {
          "items": {
            "type": "string"
          },
          "title": "Allow",
          "type": "array"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "expose_as": {
          "default": "read_tool",
          "enum": [
            "read_tool",
            "none"
          ],
          "title": "Expose As",
          "type": "string"
        }
      },
      "title": "ResourcesConfig",
      "type": "object"
    },
    "ToolAllowEntry": {
      "description": "One allow-list entry that can glob-match upstream and rename.\n\nTwo motivating cases (see issue tracker for the agent-foundry\nframework):\n\n- **Glob upstream names.** Databricks managed Genie servers expose\n  ``query_space_<space_uuid>`` -- the UUID is impossible to put in\n  ``tools.allow`` as a literal across deploys. ``match: \"query_space_*\"``\n  lets the user write a stable allow-list.\n- **Rename to a clean alias.** Managed Functions / Vector Search\n  servers expose fully-qualified names like\n  ``<catalog>__<schema>__<func>``. Concatenated with the brick's\n  ``name_prefix`` the result is unreadable for the LLM.\n  ``expose_as: <short_name>`` collapses the upstream name to a\n  stable alias before ``name_prefix`` is applied.\n\nPatterns use :mod:`fnmatch`-style globs (``*``, ``?``, ``[abc]``);\nmatching is case-sensitive because MCP tool names are documented as\ncase-sensitive identifiers. When ``expose_as`` is omitted the alias\ndefaults to the upstream name, so a glob like ``\"poll_*\"`` keeps\neach matched name verbatim while still admitting them.",
      "properties": {
        "expose_as": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expose As"
        },
        "match": {
          "title": "Match",
          "type": "string"
        }
      },
      "required": [
        "match"
      ],
      "title": "ToolAllowEntry",
      "type": "object"
    },
    "ToolsConfig": {
      "description": "Tools surface for an MCP server.\n\n``allow`` is the explicit allow-list of tool names exposed to the\nLLM. Each entry is either a bare string (exact match against the\nupstream name, no rename -- the historical shape) or a\n:class:`ToolAllowEntry` mapping with ``match`` (string or glob) and\noptional ``expose_as`` (alias). The brick fails closed when\n``allow`` is empty.\n\n``name_prefix`` is left as ``None`` here; the deploy script injects\n``<server_name>__`` when unset so the model stays decoupled from\non-disk directory naming.",
      "properties": {
        "allow": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/ToolAllowEntry"
              }
            ]
          },
          "title": "Allow",
          "type": "array"
        },
        "default_meta": {
          "additionalProperties": true,
          "title": "Default Meta",
          "type": "object"
        },
        "name_prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Prefix"
        }
      },
      "required": [
        "allow"
      ],
      "title": "ToolsConfig",
      "type": "object"
    }
  },
