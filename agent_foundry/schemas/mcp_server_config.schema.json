{
  "$defs": {
    "ArgPassthrough": {
      "description": "One field-to-arg mapping in :class:`AutoPollConfig.forward_args`.\n\nThe submit response is parsed as JSON; ``from_field`` is a dotted\npath inside that payload (``conversation_id``, ``status.state``);\nthe looked-up value is passed to the poll tool under ``to_arg``.\n\nTwo forwards are required for managed Genie (``conversation_id`` and\n``message_id``); managed SQL needs only ``statement_id``.  Modelled\nas an explicit list rather than a flat dict so the deploy state JSON\nkeeps a stable order and the alias rules are explicit.",
      "properties": {
        "from_field": {
          "title": "From Field",
          "type": "string"
        },
        "to_arg": {
          "title": "To Arg",
          "type": "string"
        }
      },
      "required": [
        "from_field",
        "to_arg"
      ],
      "title": "ArgPassthrough",
      "type": "object"
    },
    "AutoPollConfig": {
      "description": "Wrapper-side polling for async ``submit -> poll`` tool patterns.\n\nSeveral Databricks-managed MCP servers expose a two-call shape: the\nsubmit tool returns a receipt with a status ``PENDING`` (or similar),\nand a poll tool re-fetches the same receipt until terminal.  When\nauto-poll is enabled, the wrapper absorbs the polling cycle: the\nLLM sees ONE call to the trigger tool and ONE response (the\nterminal poll result), with no intermediate \"tool cells\" cluttering\nthe chat UI.\n\nPer-type defaults (:func:`ManagedSqlServerConfig._default_auto_poll`,\n:func:`ManagedGenieServerConfig._default_auto_poll`) ship out of the\nbox; the YAML knob ``auto_poll: true`` selects the type default,\n``auto_poll: false`` disables, and ``auto_poll: { ... }`` overrides\nfully.\n\nNotes:\n- When ``hide_poll_tool`` is True the poll tool is dropped from\n  :meth:`list_tools` -- the LLM cannot call it directly.  The\n  wrapper still needs ``poll_with`` in ``tools.allow`` to map the\n  alias back to the upstream name internally.\n- On timeout the wrapper returns the LAST poll result it saw (still\n  pending).  The upstream's own message is preserved so the LLM can\n  explain the timeout to the user.",
      "properties": {
        "backoff_factor": {
          "default": 2.0,
          "minimum": 1.0,
          "title": "Backoff Factor",
          "type": "number"
        },
        "forward_args": {
          "items": {
            "$ref": "#/$defs/ArgPassthrough"
          },
          "title": "Forward Args",
          "type": "array"
        },
        "hide_poll_tool": {
          "default": true,
          "title": "Hide Poll Tool",
          "type": "boolean"
        },
        "initial_interval_s": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "title": "Initial Interval S",
          "type": "number"
        },
        "max_interval_s": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "title": "Max Interval S",
          "type": "number"
        },
        "pending_states": {
          "items": {
            "type": "string"
          },
          "title": "Pending States",
          "type": "array"
        },
        "poll_with": {
          "title": "Poll With",
          "type": "string"
        },
        "state_field": {
          "default": "status.state",
          "title": "State Field",
          "type": "string"
        },
        "timeout_s": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "title": "Timeout S",
          "type": "number"
        },
        "trigger": {
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "trigger",
        "poll_with",
        "forward_args"
      ],
      "title": "AutoPollConfig",
      "type": "object"
    },
    "CustomAppServerConfig": {
      "description": "User-hosted MCP server reached at ``{app_url}`` (full URL).\n\nAuth is OBO-only; the runtime hook enforces this when constructing the\nwrapped server.",
      "properties": {
        "app_url": {
          "title": "App Url",
          "type": "string"
        },
        "auto_poll": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutoPollConfig"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Auto Poll"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "prompts": {
          "$ref": "#/$defs/PromptsConfig"
        },
        "resources": {
          "$ref": "#/$defs/ResourcesConfig"
        },
        "tools": {
          "$ref": "#/$defs/ToolsConfig"
        },
        "type": {
          "const": "custom_app",
          "default": "custom_app",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "tools",
        "app_url"
      ],
      "title": "CustomAppServerConfig",
      "type": "object"
    },
